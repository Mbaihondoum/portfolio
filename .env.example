# ─────────────────────────────────────────────────────────────────────────────
#  Portfolio — environment variables
#  Copy to `.env.local` (Next.js) and fill in. NEVER commit real values.
# ─────────────────────────────────────────────────────────────────────────────

# Public URL of the site (used for SEO, sitemap, Open Graph, CSRF origin check)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ── Database (PostgreSQL) ────────────────────────────────────────────────────
# Local (docker compose): postgres://portfolio:portfolio@localhost:5432/portfolio
# Supabase: Project Settings → Database → Connection string → "Transaction pooler"
#           (port 6543) for Vercel/serverless.
DATABASE_URL=postgres://portfolio:portfolio@localhost:5432/portfolio

# ── Admin authentication (Auth.js + GitHub OAuth) ────────────────────────────
# Generate a secret:  openssl rand -base64 32
AUTH_SECRET=
# GitHub → Settings → Developer settings → OAuth Apps → New OAuth App
#   Homepage URL:      https://your-domain.com
#   Callback URL:      https://your-domain.com/api/auth/callback/github
AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=
# Comma-separated list of GitHub account emails allowed to access /admin
ADMIN_EMAILS=you@example.com

# ── Email notifications (Resend) ─────────────────────────────────────────────
# Without RESEND_API_KEY, emails are printed to the server console (dev).
RESEND_API_KEY=
# Where contact form notifications are sent
CONTACT_TO_EMAIL=you@example.com
# Verified sender (Resend → Domains). The default works for testing only.
CONTACT_FROM_EMAIL="Portfolio <onboarding@resend.dev>"

# ── File storage (images, CV) ────────────────────────────────────────────────
# "local" writes to ./uploads (dev / docker). "supabase" uses Supabase Storage.
STORAGE_DRIVER=local
SUPABASE_URL=
# Server-only key (Project Settings → API → service_role). Never expose it.
SUPABASE_SERVICE_ROLE_KEY=
# Public bucket name (created automatically on first upload if missing)
SUPABASE_BUCKET=portfolio

# ── Anti-spam ────────────────────────────────────────────────────────────────
# Optional Cloudflare Turnstile. Leave both empty to rely on honeypot + rate limit.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
# Secret used to hash IP addresses for rate limiting (no raw IP is stored).
# Generate:  openssl rand -base64 32
IP_HASH_SECRET=
